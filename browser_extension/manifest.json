{
  "manifest_version": 3,
  "name": "Sentinel Browser Guard",
  "version": "0.1.0",
  "description": "Warns about phishing-style URLs, risky downloads and suspicious login pages.",
  "permissions": [
    "webNavigation",
    "storage",
    "downloads",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sentinel Browser Guard"
  }
}